# ═══════════════════════════════════════════════════════════
# e-Justice Sénégal - Configuration Backend
# ═══════════════════════════════════════════════════════════
# Copiez ce fichier vers .env et configurez vos valeurs
# cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# BASE DE DONNÉES (REQUIS)
# ───────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Docker: postgresql://postgres:password@localhost:5432/ejustice?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ejustice?schema=public"

# ───────────────────────────────────────────────────────────
# SERVEUR
# ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ───────────────────────────────────────────────────────────
# JWT (REQUIS)
# ───────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: Générez une clé secrète forte en production
# Exemple: openssl rand -base64 32
JWT_SECRET=votre-cle-secrete-minimum-32-caracteres-changez-en-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ───────────────────────────────────────────────────────────
# CORS
# ───────────────────────────────────────────────────────────
# URL du frontend (Vite utilise le port 5173 par défaut)
# En production: https://votre-frontend.com
CORS_ORIGIN=http://localhost:5173

# ───────────────────────────────────────────────────────────
# EMAIL - Resend (Optionnel mais recommandé)
# ───────────────────────────────────────────────────────────
# 1. Créez un compte sur https://resend.com
# 2. Validez votre domaine: https://resend.com/domains
# 3. Créez une clé API: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@votredomaine.com
EMAIL_FROM_NAME=e-Justice Sénégal

# ───────────────────────────────────────────────────────────
# SMS/WHATSAPP - Twilio (Optionnel)
# ───────────────────────────────────────────────────────────
# 1. Créez un compte sur https://twilio.com
# 2. Obtenez un numéro de téléphone
# 3. Récupérez Account SID et Auth Token depuis la console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+221xxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ───────────────────────────────────────────────────────────
# INTELLIGENCE ARTIFICIELLE (Optionnel)
# ───────────────────────────────────────────────────────────
# Option 1: Lovable AI (recommandé)
AI_PROVIDER=lovable
LOVABLE_AI_KEY=votre-cle-lovable

# Option 2: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────
# UPLOAD DE FICHIERS
# ───────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# ───────────────────────────────────────────────────────────
# RATE LIMITING
# ───────────────────────────────────────────────────────────
# 900000ms = 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ───────────────────────────────────────────────────────────
# SÉCURITÉ
# ───────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
SESSION_SECRET=votre-session-secret-changez-en-production

# ───────────────────────────────────────────────────────────
# ADMIN INITIAL (pour le seed)
# ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ejustice.sn
ADMIN_PASSWORD=Admin123!
