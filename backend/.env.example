# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ejustice?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:8080

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@ejustice.sn
EMAIL_FROM_NAME=e-Justice Sénégal

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+221xxxxxxxxx

# WhatsApp (Twilio)
TWILIO_WHATSAPP_NUMBER=whatsapp:+221xxxxxxxxx

# AI (Lovable AI Gateway ou OpenAI)
AI_PROVIDER=lovable
LOVABLE_AI_KEY=your-lovable-ai-key
OPENAI_API_KEY=your-openai-api-key

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-change-this

# Admin
ADMIN_EMAIL=admin@ejustice.sn
ADMIN_PASSWORD=ChangeThisPassword123!
